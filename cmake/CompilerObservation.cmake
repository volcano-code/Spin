# Opt-in observations of stable preprocessing inputs and real objects, NOT
# full build/source attestation. Include after project() and before any targets.
include_guard(GLOBAL)
option(MAKE_IT_STAND_OBSERVE_COMPILERS "Observe GNU compiler inputs and objects (fresh outputs required)" OFF)
set(MAKE_IT_STAND_COMPILER_EVIDENCE_DIR "" CACHE PATH "Explicit compiler observation evidence directory")
set(MAKE_IT_STAND_COMPILER_TIMEOUT "120" CACHE STRING "Total seconds allowed per compiler observation invocation")

if(NOT MAKE_IT_STAND_OBSERVE_COMPILERS)
    return()
endif()

if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Compiler observation requires GNU/Linux; disable MAKE_IT_STAND_OBSERVE_COMPILERS on this platform.")
endif()
get_property(_observation_languages GLOBAL PROPERTY ENABLED_LANGUAGES)
foreach(_observation_language IN LISTS _observation_languages)
    if(NOT _observation_language MATCHES "^(C|CXX)$" OR NOT CMAKE_${_observation_language}_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Compiler observation supports only GNU C/CXX; disable it or configure a supported compiler.")
    endif()
endforeach()
if(NOT MAKE_IT_STAND_COMPILER_EVIDENCE_DIR OR NOT IS_ABSOLUTE "${MAKE_IT_STAND_COMPILER_EVIDENCE_DIR}" OR MAKE_IT_STAND_COMPILER_EVIDENCE_DIR MATCHES "[;\n\r]")
    message(FATAL_ERROR "Compiler observation requires an explicit absolute MAKE_IT_STAND_COMPILER_EVIDENCE_DIR without list separators/newlines.")
endif()
if(NOT MAKE_IT_STAND_COMPILER_TIMEOUT MATCHES "^[0-9]+(\\.[0-9]+)?$" OR NOT MAKE_IT_STAND_COMPILER_TIMEOUT GREATER 0)
    message(FATAL_ERROR "Compiler observation requires a finite positive MAKE_IT_STAND_COMPILER_TIMEOUT in seconds.")
endif()
foreach(_observation_language C CXX)
    if(DEFINED CMAKE_${_observation_language}_COMPILER_LAUNCHER AND NOT "${CMAKE_${_observation_language}_COMPILER_LAUNCHER}" STREQUAL "")
        message(FATAL_ERROR "Compiler observation cannot replace the existing CMAKE_${_observation_language}_COMPILER_LAUNCHER; use a fresh configuration without that launcher.")
    endif()
endforeach()
find_package(Python3 3.10 COMPONENTS Interpreter REQUIRED)
execute_process(
    COMMAND "${Python3_EXECUTABLE}" -c "import math,sys; n=float(sys.argv[1]); sys.exit(0 if math.isfinite(n) and n > 0 else 1)" "${MAKE_IT_STAND_COMPILER_TIMEOUT}"
    RESULT_VARIABLE _observation_timeout_status
)
if(NOT _observation_timeout_status EQUAL 0)
    message(FATAL_ERROR "Compiler observation requires a finite positive MAKE_IT_STAND_COMPILER_TIMEOUT in seconds.")
endif()
get_filename_component(_observation_script "${CMAKE_CURRENT_LIST_DIR}/../python/make_it_stand/verification/compiler_observer.py" ABSOLUTE)
if(NOT EXISTS "${_observation_script}")
    message(FATAL_ERROR "Compiler observation launcher script is missing: ${_observation_script}")
endif()
set(_observation_launcher "${Python3_EXECUTABLE};${_observation_script};--evidence-dir;${MAKE_IT_STAND_COMPILER_EVIDENCE_DIR};--timeout;${MAKE_IT_STAND_COMPILER_TIMEOUT};--")
set(CMAKE_C_COMPILER_LAUNCHER "${_observation_launcher}")
set(CMAKE_CXX_COMPILER_LAUNCHER "${_observation_launcher}")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export commands for observed compiler invocations" FORCE)
message(STATUS "Compiler observation enabled: use fresh outputs; existing objects are rejected and must be explicitly removed by the build owner before retrying. This is NOT full build/source attestation.")
