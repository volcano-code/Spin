+std::unique_ptr<BalanceModel> BalanceModel::fromReleasedBetaArchive(
+    const Eigen::MatrixXd& normalizedVertices,
+    const Eigen::MatrixXi& faces,
+    const ReleasedBetaArchiveData& archive,
+    const BalanceModelConfig& config
+)
+{
