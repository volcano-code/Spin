{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spin-it-faster-table1-results-v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "starts_per_case",
    "maximum_restarts_per_run",
    "asset_class",
    "author_exact",
    "physical_validation",
    "cases",
    "scientific_hash"
  ],
  "properties": {
    "schema": {"const": "spin-it-faster-table1-results-v1"},
    "schema_version": {"const": 1},
    "starts_per_case": {"type": "integer", "minimum": 1},
    "maximum_restarts_per_run": {"type": "integer", "minimum": 1},
    "asset_class": {"const": "RECONSTRUCTED_ASSET"},
    "author_exact": {"const": false},
    "physical_validation": {"const": false},
    "cases": {"type": "array", "minItems": 1},
    "scientific_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
